{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["CI", "SOURCEMAPS", "ANALYZE", "DEV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "build/**"]
    },
    "//#schema:sync": {
      "cache": false
    },
    "//#schema:check": {
      "cache": false
    },
    "//#format-and-lint": {},
    "//#format-and-lint:fix": {
      "cache": false
    },
    "serve": {
      "dependsOn": ["build"]
    },
    "clean": {
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:ci": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
