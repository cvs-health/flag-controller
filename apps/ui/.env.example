# Server-side API URL. Use the Docker service name in containerized environments.
API_BASE_URL=http://localhost:8080/

# Server-side BetterAuth URL. Use the Docker service name in containerized environments.
BETTER_AUTH_URL=http://localhost:8080

# Client-side BetterAuth URL. Must be browser-accessible. Passed as a Docker build arg.
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:8080
