{
  "name": "flag-controller-api",
  "version": "1.0.0",
  "description": "Flag Controller API",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && tsup",
    "clean": "rm -rf dist",
    "generate:migration": "NODE_OPTIONS='--import tsx' pnpm drizzle-kit generate",
    "migrate": "npx tsx src/runMigrate.ts",
    "run:migration": "pnpm generate:migration && pnpm migrate",
    "start": "pnpm build && node ./dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:ci": "vitest run --coverage --silent",
    "update:schemas": "pnpm --dir ../.. schema:sync"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.7",
    "@fastify/autoload": "^6.0.0",
    "@fastify/compress": "^9.2.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/otel": "^0.20.0",
    "@fastify/sensible": "^6.0.3",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.81.0",
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.223.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/instrumentation": "^0.223.0",
    "@opentelemetry/instrumentation-http": "^0.223.0",
    "@opentelemetry/propagator-b3": "^2.11.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "better-auth": "1.7.7",
    "close-with-grace": "^2.5.0",
    "date-fns": "^4.0.0",
    "dotenv": "^18.0.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.5",
    "fastify-cli": "^8.0.0",
    "fastify-plugin": "^6.0.0",
    "json-schema-to-ts": "^3.1.1",
    "json-schema-to-typescript": "^16.0.0",
    "nanoid": "^6.0.0",
    "pg": "^8.16.0",
    "shared-constants": "workspace:*",
    "shared-utils": "workspace:*"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.0.0",
    "@parcel/watcher": "^2.4.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.11",
    "@vitest/coverage-v8": "^5.0.0",
    "drizzle-kit": "^0.31.0",
    "fastify-tsconfig": "^3.0.0",
    "shared-types": "workspace:*",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^7.0.0",
    "vitest": "^5.0.0"
  }
}
