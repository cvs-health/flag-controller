

# Allowed origin(s) for cross-origin requests (CORS). Supports a single origin
# (e.g. "http://localhost:3000") or a comma-separated list. Defaults to "http://localhost:3000".
CORS_ORIGIN=http://localhost:3000

# Optional: Set only if API and UI are deployed on sibling subdomains of the
# same parent domain (e.g. api.example.com + app.example.com -> example.com).
# Leave unset for localhost/docker-compose or single-origin deployments.
AUTH_COOKIE_DOMAIN=

# PostgreSQL connection string. Used directly in development mode.
# In production, individual DB config vars (DB_HOST, DB_USER, etc.) are used instead with SSL.
# Also used by Drizzle Kit for schema migrations.
DATABASE_URL="postgresql://user:password@localhost:5432/dbname?schema=public"

# Maximum number of connections in the PostgreSQL connection pool. Defaults to 40.
DB_POOL_MAX=20

# Minimum number of idle connections kept alive in the PostgreSQL connection pool. Defaults to 10.
DB_POOL_MIN=3

# Standard Node.js environment indicator.
NODE_ENV=development

# ── OpenTelemetry Configuration ──────────────────────────────────────────────
# All variables below are OpenTelemetry SDK standard (see the spec at
# https://opentelemetry.io/docs/specs/otel/configuration/sdk-environment-variables/).
# This file ships OpenTelemetry turned off: the repo runs no collector locally, so
# leaving it on means every export fails. Turn it on when you have a collector;
# see "OpenTelemetry" in README.md.

# SDK-wide kill switch. Set to "false" to enable all OpenTelemetry
# instrumentation. Shipped here as "true" (disabled); when the variable is unset
# the SDK's own default is "false" (enabled).
OTEL_SDK_DISABLED=true

# Identifies this service in traces and metrics dashboards.
OTEL_SERVICE_NAME=flag-controller

# Selects the trace exporter. Options: otlp | console | none
# Shipped here as "none"; the default when unset is "otlp".
OTEL_TRACES_EXPORTER=none

# Selects the metric exporter. Options: otlp | console | none
# Shipped here as "none"; the default when unset is "otlp".
OTEL_METRICS_EXPORTER=none

# Selects the log exporter. Options: otlp | console | none
# Shipped here as "none"; the default when unset is "otlp". The app emits no
# OpenTelemetry logs of its own (Fastify's pino logger is separate and is not
# routed through this exporter), so there is nothing to export.
OTEL_LOGS_EXPORTER=none

# OTLP endpoint for trace export (used when OTEL_TRACES_EXPORTER=otlp).
# Falls back to OTEL_EXPORTER_OTLP_ENDPOINT, then to http://localhost:4318.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=

# OTLP endpoint for metric export (used when OTEL_METRICS_EXPORTER=otlp).
# Falls back to OTEL_EXPORTER_OTLP_ENDPOINT, then to http://localhost:4318.
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=

# Metric export cadence in milliseconds. Defaults to 60000.
OTEL_METRIC_EXPORT_INTERVAL=60000

# OpenTelemetry SDK diagnostic log verbosity.
# Options: all, verbose, debug, info (default), warn, error, none
OTEL_LOG_LEVEL=info

# ── Server ───────────────────────────────────────────────────────────────────

# TCP port the Fastify server listens on. Defaults to 8080.
PORT=8080

# Runs database migrations automatically on startup. Set to false to disable.
RUN_MIGRATIONS_ON_START=true

# ── Sign-in ──────────────────────────────────────────────────────────────────

# Sign-in method. Options: github (default), sso (any OpenID Connect IdP).
AUTH_PROVIDER=github

# ── GitHub OAuth ─────────────────────────────────────────────────────────────
# Required when AUTH_PROVIDER=github.

# GitHub OAuth App Client ID, used by Better Auth to enable GitHub as a social login provider.
GITHUB_CLIENT_ID=

# GitHub OAuth App Client Secret, paired with GITHUB_CLIENT_ID to complete the OAuth flow
# (exchanging authorization codes for access tokens).
GITHUB_CLIENT_SECRET=

# ── OpenID Connect (SSO) ─────────────────────────────────────────────────────
# Used when AUTH_PROVIDER=sso. Only the issuer, client id and secret are required.
# Endpoints come from the issuer's discovery document, fetched at startup.

# Issuer URL, e.g. https://login.microsoftonline.com/<tenant>/v2.0
# SSO_ISSUER=
# SSO_CLIENT_ID=
# SSO_CLIENT_SECRET=

# Button text on the login page ("Login with <label>"). Default: "Login".
# SSO_LABEL=

# Comma-separated scopes. Must include openid. Default: openid,profile,email.
# SSO_SCOPES=openid,profile,email

# ID token claim that identifies a user. Default: oid, falling back to sub when
# the IdP sends no oid. A claim set here has no fallback.
# SSO_CLAIM_EXTERNAL_ID=oid

# Optional. Comma-separated email domains allowed to sign in.
# SSO_ALLOWED_EMAIL_DOMAINS=example.com

# Optional. An ID token claim that must hold one of the listed values, e.g.
# hd for a Google Workspace domain or tid for an Entra ID tenant. Set both or neither.
# SSO_ALLOWED_CLAIM=tid
# SSO_ALLOWED_CLAIM_VALUES=

# ── Identity ownership ──────────────────────────────────────────────────────
# Who owns each entity. local (default): managed in Flag Controller.
# external: owned by the identity provider, and local writes are refused with a 403.
# An external mode needs a provisioning source such as SCIM, so until one exists
# setting it stops startup. External memberships need external teams.

# IDENTITY_USERS_MODE=local          # external: only accounts the directory provisioned can sign in
# IDENTITY_TEAMS_MODE=local          # creating, renaming and deleting teams
# IDENTITY_MEMBERSHIPS_MODE=local    # adding and removing team members
# IDENTITY_APPLICATIONS_MODE=local   # creating, editing, moving and deleting applications

# Whether new users join the default team. Defaults to true only when teams and
# memberships are both local; with external teams no default team is created.
# IDENTITY_DEFAULT_TEAM=

# ── Better Auth ─────────────────────────────────────────────────────────────

# Publicly accessible base URL of this API. Used by Better Auth for OAuth
# callbacks and cookie domains. Must match the UI's BETTER_AUTH_URL.
BETTER_AUTH_URL=http://localhost:8080

# Better Auth secret used for signing/encrypting auth data.
# REQUIRED in production (NODE_ENV=production).
# Generate with: openssl rand -base64 32
# Docs: https://better-auth.com/docs/reference/options#secret
BETTER_AUTH_SECRET=
