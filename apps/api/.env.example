

# Allowed origin(s) for cross-origin requests (CORS). Supports a single origin
# (e.g. "http://localhost:3000") or a comma-separated list. Defaults to "http://localhost:3000".
CORS_ORIGIN=http://localhost:3000

# Optional: Set only if API and UI are deployed on sibling subdomains of the
# same parent domain (e.g. api.example.com + app.example.com -> example.com).
# Leave unset for localhost/docker-compose or single-origin deployments.
AUTH_COOKIE_DOMAIN=

# PostgreSQL connection string. Used directly in development mode.
# In production, individual DB config vars (DB_HOST, DB_USER, etc.) are used instead with SSL.
# Also used by Drizzle Kit for schema migrations.
DATABASE_URL="postgresql://user:password@localhost:5432/dbname?schema=public"

# Maximum number of connections in the PostgreSQL connection pool. Defaults to 40.
DB_POOL_MAX=20

# Minimum number of idle connections kept alive in the PostgreSQL connection pool. Defaults to 10.
DB_POOL_MIN=3

# Standard Node.js environment indicator.
NODE_ENV=development

# ── OpenTelemetry Configuration ──────────────────────────────────────────────
# All variables below are OpenTelemetry SDK standard (see the spec at
# https://opentelemetry.io/docs/specs/otel/configuration/sdk-environment-variables/).

# SDK-wide kill switch. Set to "true" to disable all OpenTelemetry
# instrumentation. Defaults to false (enabled).
OTEL_SDK_DISABLED=false

# Identifies this service in traces and metrics dashboards.
OTEL_SERVICE_NAME=flag-controller

# Selects the trace exporter. Options: otlp (default) | console | none
OTEL_TRACES_EXPORTER=otlp

# Selects the metric exporter. Options: otlp (default) | console | none
OTEL_METRICS_EXPORTER=otlp

# Selects the log exporter. Options: otlp (default) | console | none
# Set to "none" if you don't emit OpenTelemetry logs from the app (Fastify's
# pino logger is separate and won't be routed through this exporter).
OTEL_LOGS_EXPORTER=none

# OTLP endpoint for trace export (used when OTEL_TRACES_EXPORTER=otlp).
# Falls back to OTEL_EXPORTER_OTLP_ENDPOINT, then to http://localhost:4318.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=

# OTLP endpoint for metric export (used when OTEL_METRICS_EXPORTER=otlp).
# Falls back to OTEL_EXPORTER_OTLP_ENDPOINT, then to http://localhost:4318.
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=

# Metric export cadence in milliseconds. Defaults to 60000.
OTEL_METRIC_EXPORT_INTERVAL=60000

# OpenTelemetry SDK diagnostic log verbosity.
# Options: all, verbose, debug, info (default), warn, error, none
OTEL_LOG_LEVEL=info

# ── Server ───────────────────────────────────────────────────────────────────

# TCP port the Fastify server listens on. Defaults to 8080.
PORT=8080

# Runs database migrations automatically on startup. Set to false to disable.
RUN_MIGRATIONS_ON_START=true

# ── GitHub OAuth ─────────────────────────────────────────────────────────────

# GitHub OAuth App Client ID, used by Better Auth to enable GitHub as a social login provider.
GITHUB_CLIENT_ID=

# GitHub OAuth App Client Secret, paired with GITHUB_CLIENT_ID to complete the OAuth flow
# (exchanging authorization codes for access tokens).
GITHUB_CLIENT_SECRET=

# ── Better Auth ─────────────────────────────────────────────────────────────

# Publicly accessible base URL of this API. Used by Better Auth for OAuth
# callbacks and cookie domains. Must match the UI's BETTER_AUTH_URL.
BETTER_AUTH_URL=http://localhost:8080

# Better Auth secret used for signing/encrypting auth data.
# REQUIRED in production (NODE_ENV=production).
# Generate with: openssl rand -base64 32
# Docs: https://better-auth.com/docs/reference/options#secret
BETTER_AUTH_SECRET=
