{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:base", ":label(dependencies)"],
  "rebaseWhen": "behind-base-branch",
  "gitIgnoredAuthors": ["renovate[bot]@users.noreply.github.com", "github-actions[bot]@users.noreply.github.com"],
  "ignoreDeps": ["stefanzweifel/git-auto-commit-action", "mikefarah/yq"],
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "enabled": false,
      "matchPackageNames": ["*"]
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true
  }
}
